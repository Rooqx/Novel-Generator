{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"target": "ES2022",
		"sourceMap": true,
		"allowSyntheticDefaultImports": true
	}
}

{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "./dist",
		"baseUrl": "./",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"target": "ES2021",
		"sourceMap": true,
		"allowSyntheticDefaultImports": true
	}
}
